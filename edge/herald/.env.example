# Do not commit real secrets. Copy to `.env` and fill in.

# Environment
ENVIRONMENT=production
PORT=8000

# Runtime
HERALD_ID=herald-changeme
HERALD_NAME=Herald Node 1
HERALD_PORT=9443

# Central connectivity
CENTRAL_URL=https://unicron.central
CENTRAL_MTLS_URL=https://unicron.central:8443
UNICRON_CENTRAL_FQDN=unicron.central
API_BASE_URL=/unicron/api
SIO_PATH=/unicron/api/socket.io

# Enrollment / PKI
HERALD_ENROLL_TOKEN=changeme-enrollment-token
CA_FINGERPRINT=changeme-ca-fingerprint
HERALD_CERT_SUBJECTS=herald.example.com
HERALD_CERT_NOT_AFTER_SECONDS=43200
HERALD_CERT_RENEW_EXPIRES_IN_SECONDS=3600

# Certificate paths
HERALD_CA_ROOT=/herald-data/certs/root_ca.crt
HERALD_CERT=/herald-data/certs/unicron-herald-leaf.crt
HERALD_KEY=/herald-data/certs/unicron-herald-leaf.key

# Intervals
PING_INTERVAL=60
INVENTORY_INTERVAL=300

# Docker & Host access
DOCKER_ENDPOINT=unix:///var/run/docker.sock
HOST_PROC=/host/proc
HOST_SYS=/host/sys
HOST_ROOT=/host/root

# CORS (CSV list)
HERALD_CORS_ORIGINS=
HERALD_CORS_ORIGIN_REGEX=
HERALD_CORS_ALLOW_CREDENTIALS=true
HERALD_CORS_MAX_AGE=600

