<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
    .alert { padding: 16px; border-radius: 8px; margin: 16px 0; }
    .critical { background-color: #fee2e2; border-left: 4px solid #ef4444; }
    .warning { background-color: #fef3c7; border-left: 4px solid #f59e0b; }
    .info { background-color: #dbeafe; border-left: 4px solid #3b82f6; }
    .title { font-size: 18px; font-weight: 600; margin-bottom: 8px; }
    .meta { color: #6b7280; font-size: 14px; }
    .context { background: #f3f4f6; padding: 12px; border-radius: 4px; margin-top: 12px; }
  </style>
</head>
<body>
  <div class="alert {{ severity }}">
    <div class="title">{{ title }}</div>
    <p>{{ message }}</p>
    {% if ai_summary %}
    <div style="background: #f0f9ff; border-left: 4px solid #0ea5e9; padding: 12px; border-radius: 4px; margin: 12px 0;">
      <strong>AI Analysis:</strong><br>
      {{ ai_summary }}
    </div>
    {% endif %}
    <div class="meta">
      <strong>Rule:</strong> {{ rule_name }}<br>
      <strong>Severity:</strong> {{ severity }}<br>
      <strong>Time:</strong> {{ triggered_at }}
    </div>
    {% if context %}
    <div class="context">
      <strong>Context:</strong><br>
      {% for key, value in context.items() %}
      {{ key }}: {{ value }}<br>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</body>
</html>
