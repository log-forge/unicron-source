# Production baseline for exposing Unicron Central publicly.
# Copy to ops/unicron/.env.production and replace all changeme values.

# Public DNS and ports
UNICORN_CENTRAL_HOST=203.0.113.10
UNICRON_CENTRAL_FQDN=central.example.com
UNICRON_CENTRAL_PORT=443
UNICRON_CENTRAL_MTLS_PORT=8443
# Host-published mTLS port used in generated remote agent commands.
# Defaults to UNICRON_CENTRAL_MTLS_PORT when unset.
# UNICRON_PUBLIC_CENTRAL_MTLS_PORT=8443

# Restrict Traefik router Host() matches to your real DNS names only.
TRAEFIK_ROUTER_HOSTS=central.example.com
# Keep vendor Victoria UIs off public routes.
TRAEFIK_EXPOSE_VICTORIA_UI=false

# Local Central Auth
FRONTEND_AUTH_PROXY_BASE=/unicron/auth
CENTRAL_AUTH_SECRET=changeme-central-auth-secret-min-32-chars
CENTRAL_AUTH_COOKIE_NAME=unicron.central_auth.session
CENTRAL_ADMIN_USERNAME=admin
# Optional. Leave unset to generate a first-boot password in the central-auth log.
# Set only for an explicit bootstrap or recovery credential.
# CENTRAL_ADMIN_PASSWORD=changeme-strong-admin-password
CENTRAL_ADMIN_RECOVERY_OVERRIDE=false
CENTRAL_AUTH_MONGO_ROOT_USERNAME=root
CENTRAL_AUTH_MONGO_ROOT_PASSWORD=changeme-strong-auth-mongo-password
# Set false when the auth target uses valid public CA certs.
SKIP_AUTH_TLS_VERIFY=false

# Optional explicit browser origin allowlist.
# Keep both aligned with your public UI origins. These origins are protected in the UI.
UNICRON_ALLOWED_ORIGINS=https://central.example.com
UNICRON_ALLOW_UI_ORIGIN_ADDITIONS=true
CORS_ORIGINS=https://central.example.com

# Postgres
POSTGRES_USER=unicron
POSTGRES_DB=unicron
POSTGRES_PASSWORD=changeme-strong-postgres-password

# Frontend
UNICRON_FRONTEND_PORT=5173

# Secrets (required)
INTERNAL_API_SECRET=changeme-internal-api-secret-min-24-chars
CSRF_COOKIE_SECRET=changeme-csrf-cookie-secret-min-64-chars-random
CSRF_SECRET=changeme-csrf-secret-min-64-chars-random
# Remote agent image used in generated enrollment command
REMOTE_AGENT_IMAGE=logforge/unicron-agent:latest

# Ingest/body limits (bytes)
INTERNAL_LOGS_MAX_BODY_BYTES=2097152
INTERNAL_LOGS_HARD_MAX_BODY_BYTES=16777216
INGEST_HEALTH_WINDOW_SECONDS=300

# Backend rollout/operability kill switches
ENABLE_LOG_FANOUT_WORKER=true
ENABLE_CONTAINER_WS_RELAY=true
ENABLE_ALERT_WS_RELAY=true
ENABLE_AGENT_HEARTBEAT_MONITOR=true
ENABLE_SCHEDULER=true
