NODE_ENV=development
PORT=3020
SERVICE_NAME=central-auth
APP_VERSION=0.0.0
LOG_LEVEL=debug
LOG_PRETTY=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

COMPRESSION_ENABLED=false
BODY_PARSER_JSON_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEPALIVE_TIMEOUT_MS=5000
SHUTDOWN_DRAIN_MS=5000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=unicron
CENTRAL_AUTH_POSTGRES_SCHEMA=central_auth
POSTGRES_MAX_POOL_SIZE=10
POSTGRES_SSL=false

CENTRAL_AUTH_SECRET=changeme-central-auth-secret-min-32-chars
CENTRAL_AUTH_BASE_URL=http://localhost:3020
CENTRAL_AUTH_COOKIE_NAME=unicron.central_auth.session

CENTRAL_ADMIN_USERNAME=admin
# Optional. Leave unset to generate a first-boot password in the central-auth log.
# Set only for an explicit bootstrap or recovery credential.
# CENTRAL_ADMIN_PASSWORD=ChangeMe-Admin-Password1!
CENTRAL_ADMIN_RECOVERY_OVERRIDE=false
