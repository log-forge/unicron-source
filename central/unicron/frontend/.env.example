# Do not commit real secrets. Copy to `.env` and fill in.

# Runtime
VITE_NODE_ENV=development
PORT=5173
LOG_LEVEL=info
APP_RELEASE=
TRUST_PROXY=true

# API paths
VITE_API_BASE_URL=/api
VITE_EXTERNAL_API_BASE_URL=
VITE_SHOW_RQ_DEVTOOLS=false

# Auth URLs
VITE_BETTER_AUTH_URL=http://localhost:3020
VITE_AUTH_MODE="cookie"
VITE_APP_BASE_URL=http://localhost:3000
VITE_AUTH_BASE_URL=http://localhost:3020

# Server-side URLs (optional)
INTERNAL_API_BASE_URL=
UNICRON_CENTRAL_FQDN=
APP_BASE_URL=
AUTH_BASE_URL=
NODE_EXTRA_CA_CERTS=

# TLS (optional - local dev only)
SKIP_AUTH_TLS_VERIFY=true

# Secrets (required - generate random 32+ char strings)
CSRF_COOKIE_SECRET=changeme-csrf-cookie-secret-min-32-chars-random
CSRF_SECRET=changeme-csrf-secret-min-32-chars-random
