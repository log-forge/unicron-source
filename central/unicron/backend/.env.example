# Do not commit real secrets. Copy to `.env` and fill in.

# Core
ENVIRONMENT=development
API_BASE_URL=/unicron/api
ROOT_PATH=/unicron
CENTRAL_AUTH_BASE_URL=http://localhost:3020
CENTRAL_AUTH_VERIFY_TLS=true
CENTRAL_AUTH_SESSION_CACHE_ENABLED=true
CENTRAL_AUTH_SESSION_CACHE_TTL_SECONDS=10
CENTRAL_AUTH_SESSION_CACHE_PREFIX=unicron:auth:central_auth_session
CENTRAL_AUTH_SESSION_L1_CACHE_ENABLED=true
CENTRAL_AUTH_SESSION_L1_CACHE_TTL_SECONDS=2
CENTRAL_AUTH_SESSION_L1_STALE_GRACE_SECONDS=2

# Browser origin policy (CSV list)
# Canonical protected origins for API + Socket.IO. If empty, Central defaults to same-origin only.
UNICRON_ALLOWED_ORIGINS=https://localhost,https://127.0.0.1
# Set false to make env origins authoritative and disable UI origin additions.
UNICRON_ALLOW_UI_ORIGIN_ADDITIONS=true
# Legacy fallback (kept for compatibility)
CORS_ORIGINS=https://localhost,https://127.0.0.1
CORS_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=600

# Central host/ports
UNICRON_CENTRAL_FQDN=unicron.central
UNICRON_CENTRAL_PORT=443
UNICRON_CENTRAL_MTLS_PORT=8443
# Host-published mTLS port used in generated remote agent commands.
# Defaults to UNICRON_CENTRAL_MTLS_PORT when unset.
# UNICRON_PUBLIC_CENTRAL_MTLS_PORT=8443

# Storage
UNICRON_DATA_DIR=/var/lib/unicron

# Postgres
POSTGRES_USER=unicron
POSTGRES_PASSWORD=unicorn_password_changeme
POSTGRES_DB=unicron_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=3600

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50
SOCKETIO_REDIS_URL=redis://redis:6379/1

# Alert Deduplication
REDIS_DEDUP_TTL_SECONDS=300

# Rate Limiting
REDIS_RATE_LIMIT_WINDOW_SECONDS=60

# Redis Streams
REDIS_STREAM_ALERTS=unicron:alerts
REDIS_STREAM_NOTIFICATIONS=unicron:notifications
REDIS_CONSUMER_GROUP=alerting-workers
REDIS_STREAM_MAX_LEN=100000
AGENT_COMMAND_CHANNEL=unicron:agent:commands
AGENT_REVOCATION_CHANNEL=unicron:agent:revocations
AGENT_REVOKED_SET_KEY=unicron:agent:revoked
AGENT_REVOKED_CERT_FINGERPRINT_SET_KEY=unicron:agent:revoked:cert:fingerprint
AGENT_REVOKED_CERT_SERIAL_SET_KEY=unicron:agent:revoked:cert:serial
AGENT_CERT_METADATA_KEY_PREFIX=unicron:agent:cert:last:
AGENT_HEARTBEAT_TIMEOUT_SECONDS=60
AGENT_HEARTBEAT_MONITOR_INTERVAL_SECONDS=10
# Agent WS auth
# Agent WebSocket connections require mTLS client certificates.
REMOTE_AGENT_IMAGE=localhost:5000/unicron-go-streamer:latest
INGEST_LOG_COUNTER_KEY=unicron:ingest:logs:counters
INTERNAL_LOGS_MAX_BODY_BYTES=2097152
INTERNAL_LOGS_HARD_MAX_BODY_BYTES=16777216
INTERNAL_API_SECRET=changeme-internal-api-secret-min-24-chars
MONITORING_METRICS_KEY=unicron:monitoring:metrics
MONITORING_RECONCILE_ENABLED=true
MONITORING_RECONCILE_INTERVAL_SECONDS=60
MONITORING_RECONCILE_BATCH_SIZE=1000
HOST_FLAP_WINDOW_SECONDS=120
ENABLE_LOG_FANOUT_WORKER=true
ENABLE_CONTAINER_WS_RELAY=true
ENABLE_ALERT_WS_RELAY=true
ENABLE_AGENT_HEARTBEAT_MONITOR=true
ENABLE_SCHEDULER=true

# PKI
ROOT_CA=/ca/certs/root_ca.crt
CA_URL=https://unicron-stepca:9000
RA_URL=https://localhost:9100
RA_PROVISIONER_KEY=/ca/ra/ra.jwk.json
RA_PROVISIONER_PASSWORD_FILE=/ca/secrets/ra.jwk.pw

# VictoriaMetrics
VICTORIA_METRICS_BASE_URL=https://localhost:443/unicron/victoria-metrics
VICTORIA_LOGS_BASE_URL=https://localhost:443/unicron/victoria-logs
VICTORIA_TLS_CA_PATH=
VICTORIA_TIMEOUT_SECONDS=10
VICTORIA_RETRY_ATTEMPTS=2
VICTORIA_RETRY_BACKOFF_SECONDS=0.5
VICTORIA_METRICS_MAX_POINTS=20000
VICTORIA_LOGS_MAX_LINES=1000
VLOGS_BASE=http://unicron-victoria-logs:9428
VMETRICS_BASE=http://unicron-victoria-metrics:8428

# Timers
PING_INTERVAL=30
HERALD_STALE_THRESHOLD=120
HERALD_STALE_GRACE=3
CLEANUP_INTERVAL_SECONDS=3600
TOKEN_EXPIRY_SECONDS=18000

# Herald CORS (CSV list)
HERALD_CORS_ORIGINS=
HERALD_CORS_ORIGIN_REGEX=
HERALD_CORS_ALLOW_CREDENTIALS=true
HERALD_CORS_MAX_AGE=600

# Frontend CORS for SSE/Socket (CSV list)
FRONTEND_CORS_ORIGINS=https://localhost,https://127.0.0.1
HOST_GATEWAY=localhost
